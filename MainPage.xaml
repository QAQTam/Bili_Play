<Page x:Class="BiliPlay.MainPage" Background="Transparent"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:BiliPlay.ViewModels" xmlns:core="using:BiliPlay.Core" xmlns:local="using:BiliPlay">
 <Page.Resources>
  <local:UrlImageConverter x:Key="CoverImage"/>
  <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="GridViewItemCornerRadius">8</CornerRadius>
  <DataTemplate x:Key="DirectMessageTemplate" x:DataType="core:DirectMessage">
   <Border Padding="12" Margin="0,4" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
    <StackPanel Spacing="6"><StackPanel Orientation="Horizontal" Spacing="12"><PersonPicture Width="28" Height="28" VerticalAlignment="Center" ProfilePicture="{x:Bind SenderAvatar, Converter={StaticResource AvatarImage}, ConverterParameter=64}"/><TextBlock Text="{x:Bind SenderLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="{x:Bind Time}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><Image Source="{x:Bind Image, Converter={StaticResource CoverImage}, ConverterParameter=480}" MaxWidth="360" MaxHeight="260" Stretch="Uniform"/></StackPanel>
   </Border>
  </DataTemplate>
  <local:BoolVisibilityConverter x:Key="VisibleWhen"/>
  <local:AvatarImageConverter x:Key="AvatarImage"/>
  <local:PlaybackTimeConverter x:Key="PlaybackTime"/>
  <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
   <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="6"/><Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style x:Key="TransportToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
   <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="8"/>
   <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
   <Setter Property="Width" Value="48"/><Setter Property="MinWidth" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="MinHeight" Value="48"/>
   <Setter Property="Padding" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="FooterToggle" TargetType="ToggleButton" BasedOn="{StaticResource TransportToggle}">
   <Setter Property="Width" Value="48"/><Setter Property="MinWidth" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="0"/>
  </Style>
  <Style x:Key="TrackRowContainer" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="FocusVisualMargin" Value="1"/>
  </Style>
  <Style x:Key="NotificationRowContainer" TargetType="ListViewItem" BasedOn="{StaticResource TrackRowContainer}"><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="TileContainer" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
   <Setter Property="Margin" Value="0,0,8,8"/><Setter Property="FocusVisualMargin" Value="1"/>
  </Style>
  <Style x:Key="RecommendationTileContainer" TargetType="GridViewItem" BasedOn="{StaticResource TileContainer}">
   <Setter Property="Width" Value="200"/><Setter Property="Height" Value="288"/><Setter Property="Margin" Value="0,0,8,20"/>
  </Style>
  <DataTemplate x:Key="TrackTemplate" x:DataType="core:Track">
   <Grid Padding="4,8" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
     <Grid><FontIcon Glyph="&#xE8D6;" FontSize="20"/><local:CenteredCover CornerRadius="4" Source="{x:Bind Thumbnail, Converter={StaticResource CoverImage}, ConverterParameter=128}"/></Grid>
    </Border>
    <local:NowPlayingIndicator Grid.Column="0" Track="{x:Bind}" Loaded="PlaybackIndicatorLoaded" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
     <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}"/>
     <HyperlinkButton Content="{x:Bind UploaderDisplay}" Tag="{x:Bind}" Click="TrackUploaderClick" Padding="0" HorizontalAlignment="Left" FontSize="12" Height="32" MaxWidth="192"/>
    </StackPanel>
    <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Button Grid.Column="3" Tag="{x:Bind}" Click="TrackMoreClick" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="更多操作" AutomationProperties.Name="曲目操作"><FontIcon Glyph="&#xE712;" FontSize="16"/></Button>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="PlaylistTrackTemplate" x:DataType="core:Track">
   <Grid Padding="4,8" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="40"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
     <Grid><FontIcon Glyph="&#xE8D6;" FontSize="20"/><local:CenteredCover CornerRadius="4" Source="{x:Bind Thumbnail, Converter={StaticResource CoverImage}, ConverterParameter=128}"/></Grid>
    </Border>
    <local:NowPlayingIndicator Grid.Column="0" Track="{x:Bind}" Loaded="PlaybackIndicatorLoaded" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
     <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}"/>
     <HyperlinkButton Content="{x:Bind UploaderDisplay}" Tag="{x:Bind}" Click="TrackUploaderClick" Padding="0" HorizontalAlignment="Left" FontSize="12" Height="32" MaxWidth="192"/>
    </StackPanel>
    <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Button Grid.Column="3" Tag="{x:Bind}" Click="TrackMoreClick" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="更多操作" AutomationProperties.Name="曲目操作"><FontIcon Glyph="&#xE712;" FontSize="16"/></Button>
    <Button Grid.Column="4" Width="32" Height="32" Padding="8" Tag="{x:Bind}" Click="RemoveQueueClick" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="从播放列表移除" ToolTipService.ToolTip="从播放列表移除"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
   </Grid>
  </DataTemplate>
  <Style x:Key="CommentReactionToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
   <Setter Property="MinWidth" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="6,4"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Background" Value="Transparent"/>
  </Style>
  <DataTemplate x:Key="CommentLeafTemplate" x:DataType="vm:CommentEntry">
   <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <PersonPicture Width="32" Height="32" VerticalAlignment="Top" ProfilePicture="{x:Bind Avatar, Mode=OneWay, Converter={StaticResource AvatarImage}, ConverterParameter=96}"/>
    <StackPanel Grid.Column="1" Spacing="5">
     <HyperlinkButton Content="{x:Bind Author, Mode=OneWay}" Tag="{x:Bind AuthorId}" Click="CommentAuthorClick" Padding="0" HorizontalAlignment="Left" MaxWidth="280"/>
     <local:CommentBody Comment="{x:Bind Data, Mode=OneWay}"/>
     <TextBlock Text="{x:Bind Meta, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <StackPanel Orientation="Horizontal" Spacing="8">
      <ToggleButton Tag="{x:Bind}" Click="LikeCommentClick" IsChecked="{x:Bind IsLiked, Mode=OneWay}" IsEnabled="{x:Bind CanReact, Mode=OneWay}" Style="{StaticResource CommentReactionToggle}" AutomationProperties.Name="点赞评论" ToolTipService.ToolTip="点赞"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE8E1;" FontSize="14"/><TextBlock Text="{x:Bind LikeLabel, Mode=OneWay}" FontSize="12"/></StackPanel></ToggleButton>
      <ToggleButton Tag="{x:Bind}" Click="DislikeCommentClick" IsChecked="{x:Bind IsDisliked, Mode=OneWay}" IsEnabled="{x:Bind CanReact, Mode=OneWay}" Style="{StaticResource CommentReactionToggle}" AutomationProperties.Name="点踩评论" ToolTipService.ToolTip="点踩"><FontIcon Glyph="&#xE8E0;" FontSize="14"/></ToggleButton>
      <Button Tag="{x:Bind}" Content="回复" Click="ReplyToCommentClick" Style="{StaticResource SubtleButtonStyle}" Padding="6,4" Height="32"/>
      <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsReacting, Mode=OneWay}"/>
     </StackPanel>
    </StackPanel>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="CommentTemplate" x:DataType="vm:CommentEntry">
   <Border Padding="4,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
    <StackPanel Spacing="4">
     <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource CommentLeafTemplate}" HorizontalContentAlignment="Stretch"/>
     <Button Tag="{x:Bind}" Content="{x:Bind RepliesLabel, Mode=OneWay}" Click="ToggleCommentRepliesClick" Style="{StaticResource SubtleButtonStyle}" Margin="42,0,0,0" HorizontalAlignment="Left" Visibility="{x:Bind HasReplies, Mode=OneWay, Converter={StaticResource VisibleWhen}}"/>
     <StackPanel Margin="20,4,0,0" Spacing="8" Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource VisibleWhen}}">
      <ItemsControl ItemsSource="{x:Bind Replies}" ItemTemplate="{StaticResource CommentLeafTemplate}"/>
      <ProgressRing Width="20" Height="20" IsActive="{x:Bind IsRepliesLoading, Mode=OneWay}"/>
      <TextBlock Text="{x:Bind RepliesStatus, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Button Content="{x:Bind MoreRepliesLabel, Mode=OneWay}" Tag="{x:Bind}" Click="MoreCommentRepliesClick" IsEnabled="{x:Bind CanLoadReplies, Mode=OneWay}" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Left" Visibility="{x:Bind CanLoadReplies, Mode=OneWay, Converter={StaticResource VisibleWhen}}"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="CommentEmoteTemplate" x:DataType="core:CommentEmote">
   <Grid Width="36" Height="36" ToolTipService.ToolTip="{x:Bind Text}">
    <Image Width="30" Height="30" Source="{x:Bind Url, Converter={StaticResource CoverImage}, ConverterParameter=96}" Stretch="Uniform" Visibility="{x:Bind HasImage, Converter={StaticResource VisibleWhen}}"/>
    <TextBlock Text="{x:Bind Text}" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{x:Bind HasImage, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="NotificationTemplate" x:DataType="core:AccountNotification">
   <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid Width="56" Height="40" VerticalAlignment="Top">
      <PersonPicture Width="36" Height="36" HorizontalAlignment="Left" ProfilePicture="{x:Bind AvatarOne, Converter={StaticResource AvatarImage}, ConverterParameter=96}"/>
      <PersonPicture Width="36" Height="36" HorizontalAlignment="Left" Margin="20,0,0,0" ProfilePicture="{x:Bind AvatarTwo, Converter={StaticResource AvatarImage}, ConverterParameter=96}" Visibility="{x:Bind HasAvatarTwo, Converter={StaticResource VisibleWhen}}"/>
     </Grid>
     <StackPanel Grid.Column="1" Spacing="4" MinWidth="0">
      <TextBlock Text="{x:Bind Summary}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" MaxHeight="42"/>
      <TextBlock Text="{x:Bind Excerpt}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind HasContent, Converter={StaticResource VisibleWhen}}"/>
      <TextBlock Text="{x:Bind Time}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </StackPanel>
     <Border Grid.Column="2" Width="64" Height="48" CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" VerticalAlignment="Top" Visibility="{x:Bind HasTarget, Converter={StaticResource VisibleWhen}}">
      <Grid><local:CenteredCover CornerRadius="4" Source="{x:Bind TargetImage, Converter={StaticResource CoverImage}, ConverterParameter=128}" Visibility="{x:Bind HasTargetImage, Converter={StaticResource VisibleWhen}}"/><TextBlock Text="{x:Bind TargetExcerpt}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" FontSize="10" Padding="4" VerticalAlignment="Center" Visibility="{x:Bind HasTargetImage, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/>
      </Grid>
     </Border>
    </Grid>
   </Border>
  </DataTemplate>
 </Page.Resources>
 <Grid>
  <Grid x:Name="StartupSurface" Visibility="{x:Bind ViewModel.StartupVisibility, Mode=OneWay}"><ProgressRing Width="32" Height="32" IsActive="{x:Bind ViewModel.IsInitializing, Mode=OneWay}" AutomationProperties.Name="正在恢复账户"/></Grid>
  <Grid x:Name="LoginSurface" Visibility="{x:Bind ViewModel.LoginVisibility, Mode=OneWay}" Background="Transparent">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center">
    <StackPanel x:Name="LoginContent" Width="344" Spacing="16" HorizontalAlignment="Center" Margin="24,24">
     <Image x:Name="LoginLogo" Source="Assets/Square150x150Logo.scale-200.png" Width="80" Height="80" Stretch="Uniform" HorizontalAlignment="Center" AutomationProperties.Name="Bili Play"/>
     <TextBlock x:Name="LoginHeading" Text="登录 Bili Play" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center"/>
     <Border Background="White" CornerRadius="8" Padding="12" Width="240" Height="240" HorizontalAlignment="Center">
      <Grid><Image x:Name="LoginQrImage" Source="{x:Bind ViewModel.QrImage, Mode=OneWay}" Stretch="Uniform" AutomationProperties.Name="哔哩哔哩登录二维码"/><ProgressRing Width="32" Height="32" IsActive="{x:Bind ViewModel.LoginLoading, Mode=OneWay}"/></Grid>
     </Border>
     <TextBlock x:Name="LoginPrompt" Text="{x:Bind ViewModel.LoginStatus, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"/>
     <Button x:Name="LoginRefreshButton" Content="{x:Bind ViewModel.LoginActionLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ReconnectCommand}" HorizontalAlignment="Center"/>
    </StackPanel>
   </ScrollViewer>
   <TextBlock x:Name="LoginVersion" DoubleTapped="LoginVersionDoubleTapped" Grid.Row="1" HorizontalAlignment="Right" Margin="24,8,24,20" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"><Run Text="版本："/><Run Text="{x:Bind ViewModel.AppVersion}"/></TextBlock>
   <Button Content="取消新建配置文件" Click="CancelNewProfileClick" Visibility="{x:Bind ViewModel.NewProfileCancelVisibility, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,8,24,20"/>
  </Grid>

  <SplitView x:Name="QueueHost" DisplayMode="Overlay" PanePlacement="Right" OpenPaneLength="{x:Bind ViewModel.SidePaneWidth, Mode=OneWay}" CompactPaneLength="0" LightDismissOverlayMode="On"
    IsPaneOpen="{x:Bind ViewModel.IsSidePaneOpen, Mode=TwoWay}" Visibility="{x:Bind ViewModel.LibraryVisibility, Mode=OneWay}"
    PaneBackground="{ThemeResource AcrylicInAppFillColorDefaultBrush}" PaneOpening="QueuePaneOpening" PaneOpened="QueuePaneOpened" PaneClosed="QueuePaneClosed">
   <SplitView.Pane><Grid><Grid Visibility="{x:Bind ViewModel.IsCommentsPane, Mode=OneWay, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" x:Name="QueuePanel" TabFocusNavigation="Cycle" Background="Transparent" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Grid Margin="20,16,12,12" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="播放列表" Style="{StaticResource SubtitleTextBlockStyle}"/><Button Grid.Column="1" Width="36" Height="36" Padding="8" x:Name="QueueCloseButton" Click="CloseQueueClick" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="关闭队列"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button></Grid>
       <ListView x:Name="QueueList" ItemContainerStyle="{StaticResource TrackRowContainer}" Grid.Row="1" Margin="12,0,12,12" ItemsSource="{x:Bind ViewModel.Queue}" IsItemClickEnabled="True" ItemClick="TrackItemClicked" SelectionMode="None">
        <ListView.ItemTemplate><DataTemplate x:DataType="core:Track"><Grid Padding="4,8" ColumnSpacing="8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
         <local:NowPlayingIndicator Track="{x:Bind}" Loaded="PlaybackIndicatorLoaded" VerticalAlignment="Center"/>
         <Border Grid.Column="1" Width="48" Height="48" VerticalAlignment="Center" CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
          <Grid><FontIcon Glyph="&#xE8D6;" FontSize="20"/><local:CenteredCover CornerRadius="4" Source="{x:Bind Thumbnail, Converter={StaticResource CoverImage}, ConverterParameter=128}"/></Grid>
         </Border>
         <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
         <Button Grid.Column="3" Width="32" Height="32" Padding="6" Tag="{x:Bind}" Click="RemoveQueueClick" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="从队列移除"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
        </Grid></DataTemplate></ListView.ItemTemplate>
       </ListView>
       <TextBlock Grid.Row="1" Text="暂无播放内容" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" Visibility="{x:Bind ViewModel.HasQueue, Mode=OneWay, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/>
      </Grid>
      <Grid x:Name="CommentsPanel" Padding="16,12" RowSpacing="10" Visibility="{x:Bind ViewModel.IsCommentsPane, Mode=OneWay, Converter={StaticResource VisibleWhen}}" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind ViewModel.CommentsTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/><Button x:Name="CommentsCloseButton" Grid.Column="1" Click="CloseCommentsClick" Width="36" Height="36" Padding="8" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="关闭评论"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button></Grid>
       <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.CommentsTargetTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><RadioButtons x:Name="CommentSortPicker" MaxColumns="2" SelectedIndex="{x:Bind ViewModel.CommentSortIndex, Mode=TwoWay}"><x:String>最热</x:String><x:String>最新</x:String></RadioButtons><Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshCommentsCommand}" Width="36" Height="36" Padding="8" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="刷新评论" ToolTipService.ToolTip="刷新评论"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button></Grid>
       <Grid Grid.Row="3"><ListView x:Name="CommentList" ItemsSource="{x:Bind ViewModel.Comments}" ItemTemplate="{StaticResource CommentTemplate}" SelectionMode="None" IncrementalLoadingTrigger="Edge" IncrementalLoadingThreshold="1"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView"/></ItemsPanelTemplate></ListView.ItemsPanel></ListView><ProgressRing Width="24" Height="24" VerticalAlignment="Top" IsActive="{x:Bind ViewModel.IsCommentsLoading, Mode=OneWay}" IsHitTestVisible="False"/></Grid>
       <TextBlock Grid.Row="4" Text="{x:Bind ViewModel.CommentsStatus, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <StackPanel Grid.Row="5" Spacing="6">
        <Grid Visibility="{x:Bind ViewModel.HasCommentReplyTarget, Mode=OneWay, Converter={StaticResource VisibleWhen}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind ViewModel.CommentReplyLabel, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Click="CancelCommentReplyClick" IsEnabled="{x:Bind ViewModel.CanEditComment, Mode=OneWay}" Style="{StaticResource SubtleButtonStyle}" Width="32" Height="32" Padding="8" AutomationProperties.Name="取消回复"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button></Grid>
       <TextBox x:Name="CommentEditor" Text="{x:Bind ViewModel.CommentDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Bind ViewModel.CommentEditorPlaceholder, Mode=OneWay}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1000" MinHeight="64" MaxHeight="120" IsEnabled="{x:Bind ViewModel.CanEditComment, Mode=OneWay}" AutomationProperties.Name="评论内容"/>
       </StackPanel>
       <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="CommentEmoteButton" Width="36" Height="36" Padding="0" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.CanEditComment, Mode=OneWay}" AutomationProperties.Name="评论表情" ToolTipService.ToolTip="表情"><FontIcon Glyph="&#xE899;" FontSize="20"/>
         <Button.Flyout><Flyout x:Name="CommentEmoteFlyout" Opening="CommentEmoteOpening"><StackPanel Width="304" Spacing="8">
          <ComboBox x:Name="CommentEmotePackagePicker" ItemsSource="{x:Bind ViewModel.CommentEmotePackages}" DisplayMemberPath="Name" SelectionChanged="CommentEmotePackageChanged" HorizontalAlignment="Stretch"/>
          <Grid><GridView x:Name="CommentEmoteGrid" MaxHeight="260" IsItemClickEnabled="True" SelectionMode="None" ItemClick="CommentEmoteClick" ItemTemplate="{StaticResource CommentEmoteTemplate}"/><ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsEmotesLoading, Mode=OneWay}" IsHitTestVisible="False"/></Grid>
          <TextBlock Text="{x:Bind ViewModel.EmotesStatus, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
         </StackPanel></Flyout></Button.Flyout>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"><ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsPostingComment, Mode=OneWay}"/><Button x:Name="SendCommentButton" Content="发送" Command="{x:Bind ViewModel.SendCommentCommand}" Style="{StaticResource AccentButtonStyle}"/></StackPanel>
       </Grid>
      </Grid>
     </Grid></SplitView.Pane>
   <SplitView.Content>  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <NavigationView Background="Transparent" x:Name="Navigation" IsBackButtonVisible="Collapsed" PaneDisplayMode="Auto" IsSettingsVisible="True"
     OpenPaneLength="{x:Bind ViewModel.SidebarWidth, Mode=OneWay}" CompactModeThresholdWidth="640" ExpandedModeThresholdWidth="800"
     ItemInvoked="NavigationInvoked" DisplayModeChanged="NavigationDisplayModeChanged" PaneOpened="NavigationPaneChanged" PaneClosing="NavigationPaneClosing" PaneClosed="NavigationPaneChanged">
    <NavigationView.Resources>
     <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
     <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
     <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
    </NavigationView.Resources>
    <NavigationView.MenuItems>
     <NavigationViewItem x:Name="HomeNav" Content="首页" Tag="home" Icon="Home"/>
     <NavigationViewItem x:Name="LibraryNav" Content="收藏夹" Tag="library" Icon="Library"/>
     <NavigationViewItem Content="最近播放" Tag="history" Icon="Clock"/>
     <NavigationViewItem Content="播放列表" Tag="playlist" Icon="List"/>
     <NavigationViewItem Content="下载" Tag="cache" Icon="Download"/>
     <NavigationViewItem Content="通知中心" Tag="notifications" Icon="Message"/>
    </NavigationView.MenuItems>
    <Grid x:Name="BrowseSurface" Margin="8,0,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="28,24,28,16" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
