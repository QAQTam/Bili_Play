         <Button x:Name="ViewAgreementButton" HorizontalContentAlignment="Left" Content="查看用户协议与隐私政策" Click="ViewAgreementClick" HorizontalAlignment="Stretch"/>
         </StackPanel>
        </Grid>
       </ScrollViewer>
       <ScrollViewer x:Name="NotificationsScroller" SizeChanged="NotificationViewportSizeChanged" Padding="28,0,28,24" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" Visibility="{x:Bind ViewModel.IsNotificationsView, Mode=OneWay, Converter={StaticResource VisibleWhen}}">
        <StackPanel x:Name="NotificationsPanel" Spacing="16" MaxWidth="860" HorizontalAlignment="Left">
         <RadioButtons x:Name="NotificationCategoryPicker" MaxColumns="4" SelectedIndex="{x:Bind ViewModel.NotificationCategoryIndex, Mode=TwoWay}"><x:String>私信</x:String><x:String>收到的赞</x:String><x:String>回复与@</x:String><x:String>系统通知</x:String></RadioButtons>
         <StackPanel x:Name="NotificationLoadingRow" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,4,0,0" Visibility="{x:Bind ViewModel.IsNotificationsLoading, Mode=OneWay, Converter={StaticResource VisibleWhen}}"><ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsNotificationsLoading, Mode=OneWay}"/><TextBlock Text="正在读取通知…" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
         <Grid MinHeight="160"><ListView x:Name="NotificationList" ItemContainerStyle="{StaticResource NotificationRowContainer}" ItemsSource="{x:Bind ViewModel.VisibleNotifications, Mode=OneWay}" ItemTemplate="{StaticResource NotificationTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="NotificationClicked"></ListView><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False" Visibility="{x:Bind ViewModel.NotificationsEmpty, Mode=OneWay, Converter={StaticResource VisibleWhen}}"><FontIcon Glyph="&#xE715;" FontSize="30" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.NotificationEmptyText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel></Grid>
         <TextBlock Text="{x:Bind ViewModel.NotificationsStatus, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasNotificationStatus, Mode=OneWay, Converter={StaticResource VisibleWhen}}"/>
        </StackPanel>
       </ScrollViewer>
      </Grid>
     </Grid>
     <ProgressBar Grid.Row="2" VerticalAlignment="Top" IsIndeterminate="True" Visibility="{x:Bind ViewModel.ShowPageProgress, Mode=OneWay, Converter={StaticResource VisibleWhen}}" IsHitTestVisible="False"/>
    </Grid>
   </NavigationView>
   <Thumb x:Name="SidebarGrip" Width="8" HorizontalAlignment="Left" Margin="{x:Bind ViewModel.SidebarGripMargin, Mode=OneWay}" Visibility="Collapsed"
     DragStarted="SidebarDragStarted" DragDelta="SidebarDragDelta" DragCompleted="SidebarDragCompleted" KeyDown="SidebarKeyDown" IsTabStop="True"
     PointerEntered="SidebarPointerEntered" PointerExited="SidebarPointerExited" AutomationProperties.Name="调整侧栏宽度">
    <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"/></ControlTemplate></Thumb.Template>
   </Thumb>
   <Border x:Name="SidebarGripLine" Width="8" HorizontalAlignment="Left" Margin="{x:Bind ViewModel.SidebarGripMargin, Mode=OneWay}" Opacity="0" IsHitTestVisible="False"><Border Width="1" HorizontalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/></Border>

   <Grid x:Name="LyricsView" Visibility="Collapsed" Background="Transparent" SizeChanged="LyricsSizeChanged">
    <Grid x:Name="LyricsBody" Margin="40,28" ColumnSpacing="48">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="ArtworkWidth" Width="0.46*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid x:Name="ArtworkColumn">
      <Border x:Name="CoverFrame" Width="340" Height="340" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
       <Border.Shadow><ThemeShadow/></Border.Shadow>
       <Grid><local:CenteredCover Source="{x:Bind ViewModel.LyricsCover, Mode=OneWay}" CornerRadius="8"/><ProgressRing Width="32" Height="32" IsActive="{x:Bind ViewModel.IsPlaybackLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsPlaybackLoading, Mode=OneWay, Converter={StaticResource VisibleWhen}}"/></Grid>
      </Border>
     </Grid>
     <Grid Grid.Column="1" x:Name="LyricsColumn">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="LyricsHeader" Margin="12,4,0,20" RowSpacing="16" ColumnSpacing="12">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
       <TextBlock Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}" FontSize="28" LineHeight="36" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       <Button Grid.Column="1" Command="{x:Bind ViewModel.RetrySubtitlesCommand}" Style="{StaticResource TransportButton}" VerticalAlignment="Top" ToolTipService.ToolTip="刷新字幕" AutomationProperties.Name="刷新字幕"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
       <ComboBox Grid.Row="1" ItemsSource="{x:Bind ViewModel.SubtitleTracks}" SelectedItem="{x:Bind ViewModel.SelectedSubtitle, Mode=TwoWay}" DisplayMemberPath="DisplayName" PlaceholderText="字幕语言" MinWidth="140" MaxWidth="280" HorizontalAlignment="Left" AutomationProperties.Name="选择字幕语言"/>
      </Grid>
      <Grid Grid.Row="1" x:Name="LyricsViewport">
       <ListView x:Name="LyricsList" Loaded="LyricsListLoaded" ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="None" IsItemClickEnabled="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
        ItemClick="LyricClicked" ContainerContentChanging="LyricsContainerChanging" PointerWheelChanged="LyricsPointerWheelChanged" PointerPressed="LyricsPointerPressed" SizeChanged="LyricsViewportSizeChanged" AutomationProperties.Name="歌词，选择一行可跳转播放">
        <ListView.Header><Grid x:Name="LyricLeadingSpace" Height="64"/></ListView.Header><ListView.Footer><Grid x:Name="LyricTrailingSpace" Height="180"/></ListView.Footer>
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="CornerRadius" Value="8"/></Style></ListView.ItemContainerStyle>
        <ListView.ItemTemplate><DataTemplate x:DataType="core:SubtitleLine"><Grid Padding="12,18" Margin="0,0,12,0"><TextBlock SizeChanged="LyricTextSizeChanged" x:Name="LyricText" Text="{x:Bind Content}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="44" Opacity="0.45"/></Grid></DataTemplate></ListView.ItemTemplate>
       </ListView>
       <Button Content="返回当前歌词" Click="ResumeLyricsClick" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" Visibility="Collapsed" x:Name="ResumeLyricsButton"/>
       <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" IsHitTestVisible="False" Visibility="{x:Bind ViewModel.HasLyrics, Mode=OneWay, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
        <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsSubtitleLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsSubtitleLoading, Mode=OneWay, Converter={StaticResource VisibleWhen}}"/>
        <TextBlock Text="{x:Bind ViewModel.SubtitleStatus, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       </StackPanel>
      </Grid>
     </Grid>
    </Grid>
   </Grid>

   <Border x:Name="PlayerBar" SizeChanged="PlayerBarSizeChanged" Grid.Row="1" Padding="16,4,16,12" Tapped="PlayerBarTapped" DoubleTapped="PlayerBarDoubleTapped" IsDoubleTapEnabled="True" Background="{ThemeResource PlayerSurfaceBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
    <Grid x:Name="FooterLayout" RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="80"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" MinWidth="38" AutomationProperties.Name="已播放时长" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Slider x:Name="SeekSlider" ThumbToolTipValueConverter="{StaticResource PlaybackTime}" Grid.Column="1" Minimum="0" Maximum="{x:Bind ViewModel.Duration, Mode=OneWay}" Value="{x:Bind ViewModel.Position, Mode=TwoWay}" AutomationProperties.Name="播放进度" IsEnabled="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}"/>
      <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.RemainingText, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" MinWidth="42" TextAlignment="Right" AutomationProperties.Name="剩余时长" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </Grid>
     <Grid Grid.Row="1" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid x:Name="FooterTrackInfo" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition x:Name="FooterArtworkWidth" Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Button x:Name="NowPlayingButton" Click="OpenLyricsClick" Style="{StaticResource SubtleButtonStyle}" Padding="0" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CornerRadius="8" ToolTipService.ToolTip="打开歌词" AutomationProperties.Name="打开歌词" IsEnabled="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}">
        <Border x:Name="FooterCover" Width="80" Height="80" CornerRadius="8" Background="{ThemeResource ControlAltFillColorSecondaryBrush}"><Grid><local:CenteredCover Source="{x:Bind ViewModel.CurrentCover, Mode=OneWay}" CornerRadius="8"/><ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsPlaybackLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsPlaybackLoading, Mode=OneWay, Converter={StaticResource VisibleWhen}}"/></Grid></Border>
       </Button>
       <StackPanel x:Name="FooterMetadata" Grid.Column="1" Spacing="5" VerticalAlignment="Center">
        <Grid SizeChanged="TrackTitleSizeChanged"><StackPanel Orientation="Horizontal" Spacing="6">
         <TextBlock x:Name="PlayerTrackTitle" MaxWidth="220" Tapped="PlayerTitleTapped" Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </StackPanel>
        </Grid>
        <Grid ColumnSpacing="6" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <HyperlinkButton Content="{x:Bind ViewModel.CurrentArtist, Mode=OneWay}" Click="CurrentUploaderClick" FontSize="13" MaxWidth="200" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}"/>
         <Button Grid.Column="1" Command="{x:Bind ViewModel.FollowUploaderCommand}" IsEnabled="{x:Bind ViewModel.CanFollowUploader, Mode=OneWay}" Width="28" Height="28" Padding="5" CornerRadius="14" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.FollowLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{x:Bind ViewModel.FollowLabel, Mode=OneWay}"><FontIcon Glyph="{x:Bind ViewModel.FollowGlyph, Mode=OneWay}" FontSize="14"/></Button>
        </Grid>
       </StackPanel>
      </Grid>
      <StackPanel x:Name="TransportGroup" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
<Button Command="{x:Bind ViewModel.PreviousCommand}" Style="{StaticResource FooterButton}" ToolTipService.ToolTip="上一首" AutomationProperties.Name="上一首"  IsEnabled="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}"><FontIcon Glyph="&#xE892;" FontSize="18"/></Button><Button Command="{x:Bind ViewModel.RewindCommand}" Style="{StaticResource FooterButton}" Padding="0" ToolTipService.ToolTip="快退 10 秒" AutomationProperties.Name="快退 10 秒" IsEnabled="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}"><Grid Width="24" Height="24"><Grid><Path Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 4,10 C 7,2 20,3 22,11 M 4,10 L 4,4 M 4,10 L 10,9"/></Grid><TextBlock Text="10" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/></Grid></Button>
       <Button x:Name="PlayButton" Width="48" Height="48" CornerRadius="24" Padding="12" Command="{x:Bind ViewModel.TogglePlayCommand}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="{x:Bind ViewModel.PlayLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.PlayLabel, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}"><FontIcon Glyph="{x:Bind ViewModel.PlayGlyph, Mode=OneWay}" FontSize="22"/></Button>
<Button Command="{x:Bind ViewModel.FastForwardCommand}" Style="{StaticResource FooterButton}" Padding="0" ToolTipService.ToolTip="快进 10 秒" AutomationProperties.Name="快进 10 秒" IsEnabled="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}"><Grid Width="24" Height="24"><Grid><Grid.RenderTransform><ScaleTransform ScaleX="-1" CenterX="12"/></Grid.RenderTransform><Path Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 4,10 C 7,2 20,3 22,11 M 4,10 L 4,4 M 4,10 L 10,9"/></Grid><TextBlock Text="10" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/></Grid></Button><Button Command="{x:Bind ViewModel.NextCommand}" Style="{StaticResource FooterButton}" ToolTipService.ToolTip="下一首" AutomationProperties.Name="下一首"  IsEnabled="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}"><FontIcon Glyph="&#xE893;" FontSize="18"/></Button>
      </StackPanel>
     </Grid>
<StackPanel x:Name="FooterActions" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8"><Button Style="{StaticResource FooterButton}" ToolTipService.ToolTip="{x:Bind ViewModel.QualityToolTip, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.QualityToolTip, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock x:Name="QualityText" Text="{x:Bind ViewModel.QualityDisplayText, Mode=OneWay}" FontSize="11"/><Grid Width="8" Height="8" VerticalAlignment="Center"><ProgressRing x:Name="QualitySwitchProgress" Width="10" Height="10" MinWidth="10" MinHeight="10" IsActive="{x:Bind ViewModel.IsQualitySwitching, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsQualitySwitching, Mode=OneWay, Converter={StaticResource VisibleWhen}}"/><FontIcon Glyph="&#xE70D;" FontSize="10" Visibility="{x:Bind ViewModel.IsQualitySwitching, Mode=OneWay, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/></Grid></StackPanel><Button.Flyout><Flyout Opening="QualityMenuOpening"><StackPanel x:Name="QualityOptions" MinWidth="220" Spacing="4"/></Flyout></Button.Flyout></Button><Button Click="FavoriteCurrentClick" Style="{StaticResource FooterButton}" ToolTipService.ToolTip="收藏" AutomationProperties.Name="收藏" IsEnabled="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}"><Grid><FontIcon Glyph="&#xE734;" FontSize="17" Visibility="{x:Bind ViewModel.IsCurrentFavorited, Mode=OneWay, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/><FontIcon Glyph="&#xE735;" FontSize="17" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind ViewModel.IsCurrentFavorited, Mode=OneWay, Converter={StaticResource VisibleWhen}}"/></Grid></Button><Button x:Name="CommentsButton" Click="ToggleCommentsClick" IsEnabled="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}" Style="{StaticResource FooterButton}" Padding="0" BorderThickness="0" AutomationProperties.Name="评论" ToolTipService.ToolTip="评论"><Grid Width="24" Height="24"><FontIcon Glyph="&#xE90A;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button><Button x:Name="DownloadCurrentButton" Command="{x:Bind ViewModel.DownloadCurrentCommand}" Style="{StaticResource FooterButton}" ToolTipService.ToolTip="下载音乐" AutomationProperties.Name="下载当前音乐" IsEnabled="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}"><FontIcon Glyph="&#xE896;" FontSize="18"/></Button> <Button Style="{StaticResource FooterButton}" ToolTipService.ToolTip="{x:Bind ViewModel.PlaybackModeLabel, Mode=OneWay}" AutomationProperties.Name="播放模式" IsEnabled="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}"><FontIcon Glyph="{x:Bind ViewModel.PlaybackModeGlyph, Mode=OneWay}" FontSize="16"/><Button.Flyout><MenuFlyout Opening="PlaybackModeOpening">
 <RadioMenuFlyoutItem Text="顺序播放" Tag="0" Click="PlaybackModeClick"/>
 <RadioMenuFlyoutItem Text="列表循环" Tag="1" Click="PlaybackModeClick"/>
 <RadioMenuFlyoutItem Text="单曲循环" Tag="2" Click="PlaybackModeClick"/>
 <RadioMenuFlyoutItem Text="随机播放" Tag="3" Click="PlaybackModeClick"/>
 </MenuFlyout></Button.Flyout></Button>
 <Button x:Name="PlaybackRateButton" Style="{StaticResource FooterButton}" IsEnabled="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}" ToolTipService.ToolTip="播放速度" AutomationProperties.Name="播放速度"><TextBlock Text="{x:Bind ViewModel.PlaybackRateText, Mode=OneWay}" FontSize="12"/><Button.Flyout><MenuFlyout Opening="PlaybackRateOpening">
 <RadioMenuFlyoutItem Text="0.5×" Tag="0.5" GroupName="PlaybackSpeed" Click="PlaybackRateClick"/>
 <RadioMenuFlyoutItem Text="0.75×" Tag="0.75" GroupName="PlaybackSpeed" Click="PlaybackRateClick"/>
 <RadioMenuFlyoutItem Text="1×" Tag="1" GroupName="PlaybackSpeed" Click="PlaybackRateClick"/>
 <RadioMenuFlyoutItem Text="1.25×" Tag="1.25" GroupName="PlaybackSpeed" Click="PlaybackRateClick"/>
 <RadioMenuFlyoutItem Text="1.5×" Tag="1.5" GroupName="PlaybackSpeed" Click="PlaybackRateClick"/>
 <RadioMenuFlyoutItem Text="1.75×" Tag="1.75" GroupName="PlaybackSpeed" Click="PlaybackRateClick"/>
 <RadioMenuFlyoutItem Text="2×" Tag="2" GroupName="PlaybackSpeed" Click="PlaybackRateClick"/>
 </MenuFlyout></Button.Flyout></Button>
 <Button Style="{StaticResource FooterButton}" ToolTipService.ToolTip="{x:Bind ViewModel.VolumeLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.VolumeLabel, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}"><FontIcon Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" FontSize="18"/><Button.Flyout><Flyout><Slider Width="180" Header="音量" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" AutomationProperties.Name="音量滑块" IsEnabled="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}"/></Flyout></Button.Flyout></Button>
 <ToggleButton x:Name="QueueButton" IsChecked="{x:Bind ViewModel.ShowQueue, Mode=TwoWay}" Style="{StaticResource FooterToggle}" ToolTipService.ToolTip="播放列表" AutomationProperties.Name="播放列表"><SymbolIcon Symbol="List"/></ToggleButton></StackPanel>
    </Grid>
   </Border>
  </Grid></SplitView.Content>
  </SplitView>
  <Canvas x:Name="CoverFlightLayer" IsHitTestVisible="False" Visibility="Collapsed">
   <Border x:Name="FlyingCover" CornerRadius="8" Background="{ThemeResource ControlAltFillColorSecondaryBrush}"><local:CenteredCover x:Name="FlyingArtwork" CornerRadius="8"/></Border>
  </Canvas>
  <ItemsControl ItemsSource="{x:Bind ViewModel.Notifications}" Width="360" MaxHeight="480" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{x:Bind ViewModel.NotificationMargin, Mode=OneWay}" Translation="0,0,32">
   <ItemsControl.ItemContainerTransitions><TransitionCollection><RepositionThemeTransition/></TransitionCollection></ItemsControl.ItemContainerTransitions>
   <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ToastNotice">
    <Border Tag="{x:Bind}" Loaded="NoticeLoaded" Unloaded="NoticeUnloaded" Margin="0,6,0,0" Padding="16,12" CornerRadius="8" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"><Border.Shadow><ThemeShadow/></Border.Shadow>
     <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
      <TextBlock Text="{x:Bind Label}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{x:Bind LabelBrush}"/>
      <Button Grid.Column="1" Tag="{x:Bind}" Click="DismissNoticeClick" Width="28" Height="28" Padding="6" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="关闭通知"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind Message}" FontSize="14" TextWrapping="Wrap"/>
     </Grid>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
 </Grid>
</Page>
